# ─── CORE SERVER SETTINGS ────────────────────────────────────────────────
NODE_ENV=development # Set to 'production' on your actual server
PORT=3001
FRONTEND_URL=http://localhost:5173 # Set this to your production domain (e.g., https://swiftroute.in)
STRICT_FREE_MODE=true # Set to true to bypass all paid APIs (SMS, WhatsApp, etc.)

# ─── POSTGRESQL (Supabase / Neon - FREE) ───────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[id].supabase.co:5432/postgres

# ─── MONGODB (Atlas - FREE) ──────────────────────────────────────────────
MONGODB_URL=mongodb+srv://[user]:[pass]@[cluster].mongodb.net/swiftroute

# ─── REDIS, KAFKA & AI (Upstash & Hugging Face - FREE) ──────────────────
REDIS_URL=redis://[user]:[pass]@[endpoint].upstash.io:[port]
KAFKA_BROKERS=[endpoint].upstash.io:9092
KAFKA_SASL_USERNAME=[username]
KAFKA_SASL_PASSWORD=[password]
EMBEDDER_URL=https://[your-space].hf.space/embed

# ─── JWT (Required) ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_strong_access_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here

# ─── GOOGLE OAUTH (Required for Google Login) ────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web Application)
# Add authorised JavaScript origins: http://localhost:5173 (dev) and your prod domain
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── FIREBASE (No Credit Card required) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── OPTIONAL / PREMIUM INTEGRATIONS (PAID) ──────────────────────────────
# ... rest of the file stays the same
